{
  "name": "@openclaw/acp-channel",
  "version": "0.1.0",
  "description": "OpenClaw channel plugin for ACP (Agent Client Protocol) interface",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "bridge": "node dist/bridge.js",
    "sync": "./scripts/sync.sh",
    "sync:install": "./scripts/sync.sh && ./scripts/install.sh",
    "test:remote": "./scripts/test-remote.sh",
    "logs": "sprite -s openclaw-testbed exec -- openclaw logs --follow"
  },
  "openclaw": {
    "extensions": ["./dist/index.js"],
    "setupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "acp-channel",
      "label": "ACP Channel",
      "blurb": "Exposes OpenClaw via Agent Client Protocol (ACP) standard interface"
    }
  },
  "keywords": ["openclaw", "acp", "channel", "agent"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {}
}
